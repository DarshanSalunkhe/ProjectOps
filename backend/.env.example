# Application Environment
NODE_ENV=development

# Server Configuration
PORT=5000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/projectops

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production
JWT_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Google OAuth 2.0 Configuration
# Get NEW credentials from: https://console.cloud.google.com/apis/credentials
# ROTATE the exposed credentials before using in production
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# SMTP Configuration (Optional - for password reset & invitation emails)
# If not configured, emails will not be sent but the system will continue to work
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@projectops.example.com

# ─── AI Integration ───────────────────────────────────────────────────────────
# Set AI_PROVIDER to 'openai' or 'anthropic'. Leave blank to use deterministic fallback.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_ESCALATION_MODEL=gpt-4o

# OpenAI – get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic – get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Per-user/project monthly spend limits in USD (default: $10 / $50)
AI_USER_QUOTA_USD=10
AI_PROJ_QUOTA_USD=50

# ─── GitHub Integration ───────────────────────────────────────────────────────
# Reserved for future GitHub installation/OAuth support (no GitHub login route yet).
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Fine-grained token: read repository metadata, contents, pull requests,
# checks and commit statuses only for repositories this backend integrates.
# Used when a project is linked to a GitHub repository
GITHUB_TOKEN=ghp_...

# Shared backend AI routing: clients on laptops and phones use this same API.
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
AI_TIMEOUT_MS=30000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Conservative configurable cost reservation; update for your selected model.
GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50
AI_ENTITLEMENTS_JSON={"default":{"enabled":true,"maxOutput":2000}}

# GitHub task synchronization (apply migration 020 before enabling).
# Existing GITHUB_TOKEN and GEMINI_MODEL/GEMINI_API_KEY are reused.
# Create a random secret; put the same value in the GitHub repository webhook.
GITHUB_WEBHOOK_SECRET=
GITHUB_SYNC_ENABLED=false
GITHUB_MATCH_THRESHOLD=0.95
