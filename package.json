{
  "name": "projectops",
  "version": "1.0.0",
  "description": "Autonomous Multi-Agent Project Execution and Risk Management System",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "audit:unit": "node --test scripts/audit/regressions.test.mjs",
    "audit:browser": "playwright test --config=scripts/audit/playwright.config.mjs",
    "audit:setup": "node scripts/audit/setup.mjs",
    "audit:check-db": "node scripts/audit/check-environment.mjs",
    "audit:inventory": "node scripts/audit/inventory-controls.mjs",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "keywords": [
    "project-management",
    "risk-management",
    "autonomous-agents",
    "task-management"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^8.2.2"
  }
}
